rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Helpers */
    function isAuthed() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // superAdmin = ton compte actuel
    function isSuperAdmin() {
      return isAuthed() &&
             request.auth.uid == "rgFo1YPQNDdJxyfRCiWFXETpJHB2";
    }

    // admin = superAdmin OU utilisateur ayant un doc dans /admin/{uid}
    function isAdmin() {
      return isSuperAdmin()
        || (isAuthed()
            && exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    // livreur = utilisateur ayant un doc dans /drivers/{uid}
    function isDriver() {
      return isAuthed()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    function isStockDecrementOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['stock']) &&
             resource.data.stock is number &&
             request.resource.data.stock is number &&
             request.resource.data.stock >= 0 &&
             request.resource.data.stock <= resource.data.stock;
    }

    function isVariantsStockUpdateOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['variants']) &&
             request.resource.data.variants is map;
    }

    function isCatalogLockedFor(uid) {
      return exists(/databases/$(database)/documents/vendors/$(uid)) &&
             get(/databases/$(database)/documents/vendors/$(uid)).data.get('lockCatalog', false) == true;
    }

    /* ---------- Credit entreprise : helpers ---------- */

    // Correspondant actif d'une entreprise : document companyAdmins/{uid}.
    // (Pas de custom claims : même principe que isAdmin() avec /admin/{uid}.)
    function isCompanyAdminFor(companyId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/companyAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/companyAdmins/$(request.auth.uid)).data.companyId == companyId
        && get(/databases/$(database)/documents/companyAdmins/$(request.auth.uid)).data.status == 'active';
    }

    // Employé rattaché : document companyMembers/{companyId}__{uid}.
    // Ne jamais se fier à users/{uid}.company, que le client peut modifier.
    function isMemberOf(companyId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/companyMembers/$(companyId + '__' + request.auth.uid));
    }

    function isOwnCreditDoc() {
      return isAuthed() && resource.data.uid == request.auth.uid;
    }

    // Décision du correspondant sur une demande transmise par Monmarché.
    // Il ne peut toucher qu'à status, companyDecision et updatedAt.
    function isValidCompanyDecision() {
      let after = request.resource.data;
      let decision = after.companyDecision;
      return resource.data.status == 'pending_company_approval'
        && after.diff(resource.data).affectedKeys().hasOnly(['status', 'companyDecision', 'updatedAt'])
        && after.status in ['company_approved', 'company_rejected']
        && decision.by == request.auth.uid
        && decision.at == request.time
        && after.updatedAt == request.time
        && decision.approved == (after.status == 'company_approved')
        && (decision.approved || decision.get('note', '').size() > 0);
    }

    /* users : lecture/ecriture du proprietaire, admin, livreur en lecture (infos client livraison) */
    match /users/{uid} {
      allow read: if isAdmin() || isDriver() || isSelf(uid);
      allow create: if isSelf(uid) || isAdmin();
      allow update, delete: if isSelf(uid) || isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin() || isSelf(uid);
      }
    }
    /* admins */
    match /admin/{uid} {

      // Tous les admins peuvent voir la liste des admins
      allow read: if isAdmin();

      // Seul le superAdmin peut créer de nouveaux admins
      allow create: if isSuperAdmin();

      // Mise à jour : superAdmin peut tout, un admin peut modifier son propre profil
      allow update: if isSuperAdmin() || (isAdmin() && isSelf(uid));

      // Suppression : uniquement superAdmin
      allow delete: if isSuperAdmin();

      match /workSessions/{sessionId} {
        allow read, write: if isSuperAdmin() || (isAdmin() && isSelf(uid));
      }
    }

    /* drivers : CRUD limité aux admins, lecture par le driver lui-même possible */
    match /drivers/{uid} {
      // Un driver peut lire ses propres infos
      allow read: if isAdmin() || isSelf(uid);

      // Création / modification / suppression uniquement par un admin
      allow create, update, delete: if isAdmin();
    }

     /* Suppression du vendeur : limité aux admins */
    match /deletedVendors/{vendorId} {
      allow read, create, update, delete: if isAdmin();

      match /{document=**} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    // Bannières marketing categories (admin UI)
    match /categories/{categoryId} {
      allow read: if true; // ou isAuthed() si tu veux restreindre
      allow create, update, delete: if isAdmin();
    }

    // Bannières marketing (lues par l'app Monmarché sur la boutique)
    match /banners/{bannerId} {
      allow read: if true;

      // Création / modification / suppression uniquement par un admin
      allow create, update, delete: if isAdmin();
    }

		// Sponsors marketing (lus par l'app Monmarché sur la boutique)
    match /sponsors/{sponsorId} {
      allow read: if true;

      // Création / modification / suppression uniquement par un admin
      allow create, update, delete: if isAdmin();
    }

    // Bestseller marketing (lus par l'app Monmarché sur la boutique)
    match /bestseller/{document=**} {
      allow read: if true;

      // Création / modification / suppression uniquement par un admin
      allow create, update, delete: if isAdmin();
    }

    /* vendors : create libre pour soi, lecture proprietaire + admin + livreur
       (infos de retrait), update/delete bloqués si lockEdits=true (sauf admin).
       get('lockEdits', false) : un document sans ce champ est considéré non verrouillé
       (sinon l'accès au champ manquant fait échouer la règle). */
    match /vendors/{userId} {
      allow create: if isSelf(userId);
      allow read: if isSelf(userId) || isAdmin() || isDriver();
      allow update, delete: if (isSelf(userId) && !(resource.data.get('lockEdits', false) == true)) || isAdmin();

      match /{document=**} {
        allow read: if isSelf(userId) || isAdmin() || isDriver();
        allow write: if isAdmin();
      }
    }

    /* orders : creation par le client proprietaire, lecture/ecriture admin+livreur,
       le client peut modifier/annuler sa commande tant qu'elle n'est pas validee (payed).
       Credit entreprise : un client ne cree jamais lui-meme une commande a credit (seule
       submitOrder, SDK Admin, le peut) ; une commande a credit en attente ne peut pas etre
       prise par un livreur, et le client ne peut jamais modifier une commande a credit. */
    match /orders/{orderId} {
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('paymentType', '') != 'credit_entreprise'
        && request.resource.data.get('orderStatus', '') != 'awaiting_credit_approval'
        && !('credit' in request.resource.data);

      allow read: if isAdmin() || isDriver() ||
        (isAuthed() && resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
        || (isDriver() && resource.data.get('orderStatus', '') != 'awaiting_credit_approval')
        || (isAuthed()
            && resource.data.userId == request.auth.uid
            && resource.data.payed != true
            && resource.data.get('paymentType', '') != 'credit_entreprise');

      // Suppression uniquement par l'admin (etape d'archivage vers archivedOrders)
      allow delete: if isAdmin();
    }

    /* archivedOrders : reserve a l'admin. La creation ici declenche le calcul des
       commissions vendeur (Cloud Function) ; ne doit jamais etre accessible en
       ecriture a un client/livreur pour eviter des lignes de paiement forgees. */
    match /archivedOrders/{document=**} {
      allow read, write: if isAdmin();
    }

    /* archivedFakeOrders : fausses commandes archivees, collection separee de
       archivedOrders pour ne jamais declencher le calcul des commissions
       vendeur ni polluer les stats de ventes/livraison. Admin uniquement. */
    match /archivedFakeOrders/{document=**} {
      allow read, write: if isAdmin();
    }

    /* ---------- Credit entreprise ---------- */

    /* Entreprises partenaires : gérées par Monmarché, lues par leur correspondant et leurs employés */
    match /companies/{companyId} {
      allow read: if isAdmin() || isCompanyAdminFor(companyId) || isMemberOf(companyId);
      allow write: if isAdmin();
    }

    /* Correspondants */
    match /companyAdmins/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow write: if isAdmin();
    }

    /* Codes de rattachement : créés et annulés par le correspondant.
       L'activation par l'employé passe par une fonction serveur. */
    match /enrollmentCodes/{code} {
      allow read: if isAdmin() || isCompanyAdminFor(resource.data.companyId);
      allow create: if isAdmin()
        || (isCompanyAdminFor(request.resource.data.companyId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.memberLimit is int
            && request.resource.data.memberLimit >= 0
            && !('usedBy' in request.resource.data)
            && !('revokedAt' in request.resource.data));
      allow update: if isAdmin()
        || (isCompanyAdminFor(resource.data.companyId)
            && !('usedBy' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])
            && request.resource.data.revokedAt == request.time);
      allow delete: if isAdmin();
    }

    /* Employés rattachés : le correspondant règle le plafond et le statut */
    match /companyMembers/{memberId} {
      allow read: if isAdmin() || isCompanyAdminFor(resource.data.companyId) || isOwnCreditDoc();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isCompanyAdminFor(resource.data.companyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditLimit', 'status', 'updatedAt'])
            && request.resource.data.creditLimit is int
            && request.resource.data.creditLimit >= 0
            && request.resource.data.status in ['active', 'suspended', 'left']
            && request.resource.data.updatedAt == request.time);
    }

    /* Crédits : Monmarché gère tout ; le correspondant ne fait que valider ou refuser */
    match /creditAgreements/{agreementId} {
      allow read: if isAdmin() || isCompanyAdminFor(resource.data.companyId) || isOwnCreditDoc();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isCompanyAdminFor(resource.data.companyId) && isValidCompanyDecision());
    }

    /* Remboursements : enregistrés par Monmarché, jamais modifiés (une erreur
       se corrige par une écriture d'annulation au montant négatif) */
    match /creditPayments/{paymentId} {
      allow read: if isAdmin() || isCompanyAdminFor(resource.data.companyId) || isOwnCreditDoc();
      allow create: if isAdmin()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount != 0
        && request.resource.data.method in ['orange_money', 'cash', 'bank_transfer', 'other'];
      allow update, delete: if false;
    }

    /* Rappels : créés par Monmarché ; le statut d'envoi est mis à jour par la
       fonction serveur (SDK Admin) */
    match /creditReminders/{reminderId} {
      allow read: if isAdmin() || isCompanyAdminFor(resource.data.companyId) || isOwnCreditDoc();
      allow create: if isAdmin()
        && request.resource.data.sentBy == request.auth.uid
        && request.resource.data.channel in ['push', 'email', 'sms', 'phone'];
      allow update, delete: if false;
    }

    /* reviews : avis clients soumis via submitReview (Cloud Function, Admin SDK,
       contourne ces regles a l'ecriture). Lecture admin uniquement : contient
       userId + commentaire libre, ne doit pas etre public. */
    match /reviews/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* mail : ecriture reservee aux comptes authentifies (client/vendeur/livreur/admin) */
    match /mail/{document=**} { allow write: if isAuthed(); }

    /* game / gameTest (inchangé) */
    match /game/{codeId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
      allow delete: if (request.auth != null && resource.data.createdBy == request.auth.uid)
                    || request.auth.uid == 'rgFo1YPQNDdJxyfRCiWFXETpJHB2';
    }

    match /gameTest/{document=**} { allow read, write: if true; }

    /* zones (inchangé) */
    match /zones/{zoneId} { allow read, write: if isAuthed(); }

    /* products : vos produits internes (lecture publique, writes via backend/admin si besoin) */
    match /products/{productId} {
      // lecture publique comme avant
      allow read: if true;

      allow create, read, write:
        if isAdmin();
    }

    /* ---------- vendor_products : produits des vendeurs ---------- */

    /* Modèle plat : /vendor_products/{productId} (avec champ vendorId) */
      match /vendor_products/{productId} {
      function isOwnerFromPayload() {
        return isAuthed() &&
               request.resource.data.vendorId is string &&
               request.resource.data.vendorId == request.auth.uid;
      }

      function isOwnerExisting() {
        return isAuthed() &&
               resource.data.vendorId is string &&
               resource.data.vendorId == request.auth.uid;
      }

      allow read: if isAuthed() || isAdmin();

      allow create: if (isOwnerFromPayload() && !isCatalogLockedFor(request.auth.uid)) || isAdmin();

      allow update: if
        (isOwnerExisting() && !isCatalogLockedFor(request.auth.uid)) ||
        isAdmin() ||
        (isAuthed() && isStockDecrementOnly());

      allow delete: if (isOwnerExisting() && !isCatalogLockedFor(request.auth.uid)) || isAdmin();
    }

    /* catalog_public : publié uniquement par Cloud Functions */
    match /catalog_public/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /products_public/{productId} {
      function isOwnerFromPayload() {
        return isAuthed() &&
               request.resource.data.vendorId is string &&
               request.resource.data.vendorId == request.auth.uid;
    }

      function isOwnerExisting() {
        return isAuthed() &&
               resource.data.vendorId is string &&
               resource.data.vendorId == request.auth.uid;
      }

      allow read: if true;

      allow create: if isOwnerFromPayload() || isAdmin();

      allow update: if
        isOwnerExisting() ||
        isAdmin() ||
        (isAuthed() && isStockDecrementOnly());

      allow delete: if isOwnerExisting() || isAdmin();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
		match /app_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /admin/{uid}/notifications/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false; // créé uniquement par Cloud Functions
    }
    /* counters : compteurs internes (numero de facture sequentiel...), admin uniquement */
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    match /product_sales_ledger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /image_optimization_jobs/{jobId} {
  allow read: if isAdmin();
  allow write: if false;

  match /{document=**} {
    allow read: if isAdmin();
    allow write: if false;
  }
}

match /image_optimization_config/{documentId} {
  allow read: if isAdmin();
  allow write: if false;
}

    /* catch-all read (inchangé) */
    match /{document=**} {
      allow read: if true;
    }
  }
}
